{
  "name": "@outfitter/skilltree",
  "version": "0.0.0",
  "private": true,
  "description": "A scaffold for Git-backed skill synchronization that preserves local edits.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "test": "bun test",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build",
    "setup": "bash scripts/bootstrap.sh"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
